---
import config from 'virtual:starlight/user-config';

const t = Astro.locals.t;
// Résolution dynamique sans hardcode 'fr' : dérivé de astro.config.mjs locales/defaultLocale
const defaultLocale = config.defaultLocale ?? 'root';
const rootLang = (config.locales as Record<string, { lang?: string }>)?.root?.lang ?? 'fr';
const rawLocale = Astro.currentLocale ?? defaultLocale;
const locale = rawLocale === 'root' ? rootLang : rawLocale;
---

<div
  class="newsletter"
  id="newsletter-root"
  data-locale={locale}
  data-i18n-button={t('newsletter.button')}
  data-i18n-rate-limit={t('newsletter.errorRateLimit')}
  data-i18n-network={t('newsletter.errorNetwork')}
  data-i18n-subscribe={t('newsletter.errorSubscribe')}
>
  <div class="newsletter-badge">{t('newsletter.badge')}</div>
  <h3 class="newsletter-title">{t('newsletter.title')}</h3>
  <p class="newsletter-desc">
    {t('newsletter.descPrefix')} <strong>{t('newsletter.descBold1')}</strong> {t('newsletter.descAnd')} <strong>{t('newsletter.descBold2')}</strong> {t('newsletter.descSuffix')}
  </p>

  <form class="newsletter-form" id="newsletter-form">
    <div class="newsletter-row">
      <input type="email" name="email" placeholder={t('newsletter.placeholder')} required class="newsletter-input" />
      <button type="submit" class="newsletter-btn" id="newsletter-btn">{t('newsletter.button')}</button>
    </div>
    <p class="newsletter-disclaimer">{t('newsletter.disclaimer')}</p>

    <!-- Honeypot anti-bot -->
    <div aria-hidden="true" style="position:absolute;left:-9999px" tabindex="-1">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
  </form>

  <div class="newsletter-success" id="newsletter-success">
    <span class="success-check">✓</span>
    <p class="success-text">{t('newsletter.success')}</p>
  </div>

  <div class="newsletter-error" id="newsletter-error">
    <p class="error-text" id="error-text"></p>
    <button type="button" class="error-retry" id="error-retry">{t('newsletter.errorRetry')}</button>
  </div>
</div>

<style>
  .newsletter {
    position: relative;
    margin: 3rem 0;
    padding: 2rem;
    border-radius: 12px;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
  }
  .newsletter-badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-accent);
    background: rgba(251, 191, 36, 0.1);
    border-radius: 100px;
    margin-bottom: 0.75rem;
  }
  .newsletter-title {
    margin: 0 0 0.375rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .newsletter-desc {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  .newsletter-desc strong { color: var(--sl-color-white); }
  .newsletter-row {
    display: flex;
    gap: 0.5rem;
    max-width: 440px;
  }
  .newsletter-input {
    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    color: var(--sl-color-white);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    outline: none;
    transition: border-color 0.2s;
  }
  .newsletter-input::placeholder { color: var(--sl-color-gray-4); }
  .newsletter-input:focus { border-color: var(--sl-color-accent); }
  .newsletter-btn {
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-bg);
    background: var(--sl-color-accent);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
  }
  .newsletter-btn:hover { opacity: 0.9; }
  .newsletter-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .newsletter-disclaimer {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
  }
  .newsletter-success {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
  }
  .success-check { font-size: 1.25rem; color: rgb(34, 197, 94); }
  .success-text { margin: 0; font-weight: 600; color: var(--sl-color-white); }
  .newsletter-error {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }
  .error-text { margin: 0; font-size: 0.85rem; color: rgb(239, 68, 68); }
  .error-retry {
    padding: 0;
    font-size: 0.85rem;
    color: var(--sl-color-accent);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .newsletter-row { flex-direction: column; }
    .newsletter-btn { width: 100%; }
  }
</style>

<script>
  const RATE_LIMIT_MS = 60_000;

  const baseUrl = (import.meta.env.PUBLIC_API_URL ?? "").trim().replace(/\/+$/, "");
  const API_ENDPOINT = baseUrl ? `${baseUrl}/api/subscribe` : "/api/subscribe";

  const root = document.getElementById("newsletter-root") as HTMLDivElement | null;
  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
  const btn = document.getElementById("newsletter-btn") as HTMLButtonElement | null;
  const success = document.getElementById("newsletter-success") as HTMLDivElement | null;
  const errorBox = document.getElementById("newsletter-error") as HTMLDivElement | null;
  const errorText = document.getElementById("error-text") as HTMLParagraphElement | null;
  const retryBtn = document.getElementById("error-retry") as HTMLButtonElement | null;

  // i18n injecté côté serveur via data-attributes (remplace navigator.language)
  const locale = root?.dataset.locale ?? "fr";
  const i18n = {
    button: root?.dataset.i18nButton ?? "Join Waitlist",
    rateLimit: root?.dataset.i18nRateLimit ?? "Please wait before submitting again.",
    network: root?.dataset.i18nNetwork ?? "Network error. Please try again.",
    subscribe: root?.dataset.i18nSubscribe ?? "Failed to subscribe",
  };

  function reset(): void {
    if (!form || !success || !errorBox || !btn) return;
    form.style.display = "";
    success.style.display = "none";
    errorBox.style.display = "none";
    btn.textContent = i18n.button;
    btn.removeAttribute("disabled");
  }

  form?.addEventListener("submit", async (e: SubmitEvent) => {
    e.preventDefault();
    if (!form || !btn || !success || !errorBox || !errorText) return;

    const formData = new FormData(form);
    if (formData.get("website")) return;

    const prev = localStorage.getItem("newsletter-ts");
    if (prev && Date.now() - Number(prev) < RATE_LIMIT_MS) {
      errorText.textContent = i18n.rateLimit;
      errorBox.style.display = "flex";
      return;
    }

    const email = String(formData.get("email") ?? "").trim();
    if (!email) return;

    form.style.display = "none";
    success.style.display = "flex";

    const autoResetTimer = setTimeout(() => {
      reset();
      form.reset();
    }, 3000);

    try {
      const res = await fetch(API_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email,
          notes: `Blog Center Subscription (${locale})`,
          userGroup: "Blog",
        }),
      });

      if (!res.ok) {
        const errData = (await res.json().catch(() => ({}))) as { error?: string; message?: string };
        throw new Error(errData.error || errData.message || i18n.subscribe);
      }

      localStorage.setItem("newsletter-ts", Date.now().toString());
    } catch (err: unknown) {
      clearTimeout(autoResetTimer);
      form.style.display = "";
      success.style.display = "none";
      btn.textContent = i18n.button;
      btn.removeAttribute("disabled");

      errorText.textContent = err instanceof Error ? err.message : i18n.network;
      errorBox.style.display = "flex";
    }
  });

  retryBtn?.addEventListener("click", reset);
</script>
