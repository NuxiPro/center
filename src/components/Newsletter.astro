---
---

<div class="newsletter">
  <div class="newsletter-badge">Early Access</div>
  <h3 class="newsletter-title">Get early access to NuxiPro Cloud</h3>
  <p class="newsletter-desc">
    Join the waitlist for <strong>exclusive newsletters</strong> and <strong>pre-release access</strong> before the official launch.
  </p>

  <form class="newsletter-form" id="newsletter-form">
    <div class="newsletter-row">
      <input type="email" name="email" placeholder="your.email@example.com" required class="newsletter-input" />
      <button type="submit" class="newsletter-btn" id="newsletter-btn">Join Waitlist</button>
    </div>
    <p class="newsletter-disclaimer">No spam. Unsubscribe anytime.</p>

    <!-- Honeypot anti-bot -->
    <div aria-hidden="true" style="position:absolute;left:-9999px" tabindex="-1">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
  </form>

  <div class="newsletter-success" id="newsletter-success">
    <span class="success-check">✓</span>
    <p class="success-text">You're on the list!</p>
  </div>

  <div class="newsletter-error" id="newsletter-error">
    <p class="error-text" id="error-text"></p>
    <button type="button" class="error-retry" id="error-retry">Try again</button>
  </div>
</div>

<style>
  .newsletter {
    position: relative;
    margin: 3rem 0;
    padding: 2rem;
    border-radius: 12px;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
  }
  .newsletter-badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-accent);
    background: rgba(251, 191, 36, 0.1);
    border-radius: 100px;
    margin-bottom: 0.75rem;
  }
  .newsletter-title {
    margin: 0 0 0.375rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .newsletter-desc {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  .newsletter-desc strong { color: var(--sl-color-white); }
  .newsletter-row {
    display: flex;
    gap: 0.5rem;
    max-width: 440px;
  }
  .newsletter-input {
    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    color: var(--sl-color-white);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    outline: none;
    transition: border-color 0.2s;
  }
  .newsletter-input::placeholder { color: var(--sl-color-gray-4); }
  .newsletter-input:focus { border-color: var(--sl-color-accent); }
  .newsletter-btn {
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-bg);
    background: var(--sl-color-accent);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
  }
  .newsletter-btn:hover { opacity: 0.9; }
  .newsletter-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .newsletter-disclaimer {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
  }
  .newsletter-success {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
  }
  .success-check { font-size: 1.25rem; color: rgb(34, 197, 94); }
  .success-text { margin: 0; font-weight: 600; color: var(--sl-color-white); }
  .newsletter-error {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }
  .error-text { margin: 0; font-size: 0.85rem; color: rgb(239, 68, 68); }
  .error-retry {
    padding: 0;
    font-size: 0.85rem;
    color: var(--sl-color-accent);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .newsletter-row { flex-direction: column; }
    .newsletter-btn { width: 100%; }
  }
</style>

<script>
  const RATE_LIMIT_MS = 60_000;

  // Endpoint dynamique zéro hardcode via variables d'environnement Astro
  const baseUrl = (import.meta.env.PUBLIC_API_URL ?? "").trim().replace(/\/+$/, "");
  const API_ENDPOINT = baseUrl ? `${baseUrl}/api/subscribe` : "/api/subscribe";

  const form = document.getElementById("newsletter-form") as HTMLFormElement;
  const btn = document.getElementById("newsletter-btn") as HTMLButtonElement;
  const success = document.getElementById("newsletter-success") as HTMLDivElement;
  const errorBox = document.getElementById("newsletter-error") as HTMLDivElement;
  const errorText = document.getElementById("error-text") as HTMLParagraphElement;
  const retryBtn = document.getElementById("error-retry") as HTMLButtonElement;

  function detectLang(): string {
    return (navigator.language || "en").toLowerCase().startsWith("fr") ? "fr" : "en";
  }

  function reset(): void {
    form.style.display = "";
    success.style.display = "none";
    errorBox.style.display = "none";
    btn.textContent = "Join Waitlist";
    btn.removeAttribute("disabled");
  }

  form?.addEventListener("submit", async (e: SubmitEvent) => {
    e.preventDefault();

    // 1. Protection Anti-bot Honeypot
    const formData = new FormData(form);
    if (formData.get("website")) return;

    // 2. Protection Rate-limiting côté client
    const prev = localStorage.getItem("newsletter-ts");
    if (prev && Date.now() - Number(prev) < RATE_LIMIT_MS) {
      errorText.textContent = "Please wait before submitting again.";
      errorBox.style.display = "flex";
      return;
    }

    const email = String(formData.get("email") ?? "").trim();
    if (!email) return;

    // 3. UI Optimiste instantanée
    form.style.display = "none";
    success.style.display = "flex";

    const autoResetTimer = setTimeout(() => {
      reset();
      form.reset();
    }, 3000);

    // 4. Envoi sécurisé au backend Plunk
    try {
      const res = await fetch(API_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email,
          notes: `Blog Center Subscription (${detectLang()})`,
          userGroup: "Blog",
        }),
      });

      if (!res.ok) {
        const errData = (await res.json().catch(() => ({}))) as { error?: string; message?: string };
        throw new Error(errData.error || errData.message || "Failed to subscribe");
      }

      localStorage.setItem("newsletter-ts", Date.now().toString());
    } catch (err: unknown) {
      // Fallback propre en cas d'erreur réseau / backend
      clearTimeout(autoResetTimer);
      form.style.display = "";
      success.style.display = "none";
      btn.textContent = "Join Waitlist";
      btn.removeAttribute("disabled");

      errorText.textContent = err instanceof Error ? err.message : "Network error. Please try again.";
      errorBox.style.display = "flex";
    }
  });

  retryBtn?.addEventListener("click", reset);
</script>
