---
/**
 * Navbar social icons (Starlight `SocialIcons` override).
 *
 * Same rendering as Starlight's default component, except the RSS icon is
 * filtered out: `starlight-blog` auto-injects an RSS social link into the
 * header, where it overlaps the search `Ctrl+K` badge. The feed itself stays
 * available in the blog (`/blog/rss.xml` + autodiscovery).
 * Registered in `astro.config.mjs` under `starlight.components.SocialIcons`.
 */
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

type SocialLink = { label: string; href: string; icon: StarlightIcon };

const links: SocialLink[] = ((config.social ?? []) as SocialLink[]).filter(
  ({ icon }: SocialLink) => icon !== 'rss',
);
---

{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }: SocialLink) => (
				<a {href} rel="me" class="sl-flex">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
	}
</style>
