---
/**
 * Document head (Starlight `Head` override).
 *
 * Extends Starlight's default head with favicon, Apple touch icon and
 * Open Graph / Twitter Card share image. All point to `public/logo.png`.
 * Registered in `astro.config.mjs` under `starlight.components.Head`.
 */
import DefaultHead from '@astrojs/starlight/components/Head.astro';
---

<DefaultHead />

<!-- Favicon (browser tab) — uses the `public/logo.png` file -->
<link rel="icon" href="/logo.png" type="image/png" />

<!-- Apple touch icon — uses the same PNG -->
<link rel="apple-touch-icon" href="/logo.png" sizes="180x180" />

<!-- Open Graph / Twitter Card (share image) — uses the same PNG -->
<meta property="og:image" content="/logo.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="/logo.png" />
