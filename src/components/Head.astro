---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
---

<DefaultHead />

<!-- Favicon – icône de l’onglet – utilise le fichier public/logo.png -->
<link rel="icon" href="/logo.png" type="image/png" />

<!-- Apple Touch Icon – utilise le même PNG -->
<link rel="apple-touch-icon" href="/logo.png" sizes="180x180" />

<!-- Open Graph / Twitter Card – image de partage – utilise le même PNG -->
<meta property="og:image" content="/logo.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="/logo.png" />
