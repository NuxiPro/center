---
/**
 * "Latest posts" dynamic block used on the homepage (`index.mdx`).
 *
 * Reads the `docs` collection, keeps dated `blog/` entries matching `locale`,
 * sorts them newest-first and renders the top 3 as cards. Renders nothing
 * when there are no posts, so the homepage never looks empty or stale.
 *
 * @param locale - `'fr'` (root, `/`) or `'en'` (`/en/`).
 * @param title - Section heading.
 * @param subtitle - Optional section subheading.
 * @param seeAllText - Label of the link to the full blog index.
 * @param seeAllHref - URL of the full blog index (`/blog/` or `/en/blog/`).
 */
import { getCollection } from 'astro:content';

interface Props {
  locale: 'fr' | 'en';
  title: string;
  subtitle?: string;
  seeAllText: string;
  seeAllHref: string;
}

const { locale, title, subtitle, seeAllText, seeAllHref } = Astro.props;

const all = await getCollection('docs');

const posts = all
  .filter((e) => {
    const id = e.id as string;
    if (!id.includes('blog/')) return false;
    // Skip the blog index page itself: only dated articles.
    const date = (e.data as { date?: unknown }).date;
    if (!date) return false;
    return locale === 'en' ? id.startsWith('en/') : !id.startsWith('en/');
  })
  .sort((a, b) => {
    const da = new Date((a.data as { date: string | Date }).date).getTime();
    const db = new Date((b.data as { date: string | Date }).date).getTime();
    return db - da;
  })
  .slice(0, 3);

function slugOf(id: string): string {
  // "blog/foo" -> "/blog/foo/" | "en/blog/foo" -> "/en/blog/foo/"
  return '/' + id.replace(/\.mdx?$/, '') + '/';
}

function formatDate(value: string | Date): string {
  const d = value instanceof Date ? value : new Date(value);
  return d.toLocaleDateString(locale === 'en' ? 'en-US' : 'fr-FR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}
---

{posts.length > 0 && (
  <section class="recent-blog">
    <div class="recent-head">
      <div>
        <h2>{title}</h2>
        {subtitle && <p>{subtitle}</p>}
      </div>
      <a class="see-all" href={seeAllHref}>{seeAllText} →</a>
    </div>
    <div class="recent-grid">
      {posts.map((post) => {
        const data = post.data as { title: string; description?: string; date: string | Date };
        return (
          <a class="post-card" href={slugOf(post.id as string)}>
            <time>{formatDate(data.date)}</time>
            <strong>{data.title}</strong>
            {data.description && <span>{data.description}</span>}
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .recent-blog { margin: 2.5rem 0 1rem; }
  .recent-head {
    display: flex; justify-content: space-between; align-items: end;
    gap: 1rem; margin-bottom: 1rem;
  }
  .recent-head h2 { margin: 0; font-size: 1.25rem; }
  .recent-head p { margin: 0.25rem 0 0; color: var(--sl-color-gray-3); font-size: 0.9rem; }
  .see-all { font-size: 0.85rem; white-space: nowrap; }
  .recent-grid {
    display: grid; gap: 0.75rem;
    grid-template-columns: repeat(3, 1fr);
  }
  .post-card {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 1rem; border-radius: 12px; text-decoration: none;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
  }
  .post-card:hover { border-color: var(--sl-color-accent); }
  .post-card time { font-size: 0.75rem; color: var(--sl-color-gray-3); }
  .post-card strong { color: var(--sl-color-white); line-height: 1.3; }
  .post-card span { font-size: 0.85rem; color: var(--sl-color-gray-3); line-height: 1.45; }
  @media (max-width: 720px) { .recent-grid { grid-template-columns: 1fr; } }
</style>
